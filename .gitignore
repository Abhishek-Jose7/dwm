.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Eclipse
.project
.pydevproject
.settings/

# Vim / Emacs
*.swp
*.swo
[#]*[#]
.#*

# ------------------------------------------------------------------------------
# 5. Office, Power BI & Tableau Temporary Files
# ------------------------------------------------------------------------------
# Microsoft Office lock files generated during editing
~$*.pptx
~$*.xlsx
~$*.docx
~$*.doc
~$*.ppt

# Power BI / Tableau temp and backup files
*.tmp
*.temp
*.bak
*.pbit.backup
*.twbx.temp

# ------------------------------------------------------------------------------
